+            | (GattOperation::Discover, CoreBluetoothMessage::DiscoverServices { future, .. })
+            | (GattOperation::Read, CoreBluetoothMessage::ReadValue { future, .. })
+            | (GattOperation::Write, CoreBluetoothMessage::WriteValue { future, .. })
