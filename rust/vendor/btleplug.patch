+async fn dispatch_event(sender: &Sender<CoreBluetoothEvent>, event: CoreBluetoothEvent) {
+    // The event owns the reply until consumed. A separate guard covers
+    // cancellation while send is pending, even if the event was enqueued
+    // before Sink::send's flush completed.
+    let mut pending = match &event {
+        CoreBluetoothEvent::RetrievedPeripherals { future, .. }
+        | CoreBluetoothEvent::PeripheralsCleared { future } => Some(future.dispatch_guard()),
+        CoreBluetoothEvent::CallbackFailed { .. }
+        | CoreBluetoothEvent::DidUpdateState { .. }
+        | CoreBluetoothEvent::DeviceDiscovered { .. }
+        | CoreBluetoothEvent::DeviceUpdated { .. }
+        | CoreBluetoothEvent::DeviceDisconnected { .. } => None,
+    };
+    let mut s = sender.clone();
+    if let Err(e) = s.send(event).await {
+        error!("Error dispatching event: {:?}", e);
+    } else if let Some(guard) = pending.as_mut() {
+        guard.0 = None;
+    }
 }
 
