+/// Confirm retirement and release the internal sender before publishing adapter events.
+fn retire_disconnected(
+    peripherals: &mut HashMap<Uuid, PeripheralInternal>,
+    uuid: Uuid,
+    error: Option<super::native_error::NativeError>,
+) -> Option<CoreBluetoothEvent> {
+    let mut peripheral = peripherals.remove(&uuid)?;
+    peripheral.confirm_disconnect_with_error(error);
+    // Dropping the last internal sender closes the peripheral reader naturally.
+    // An ignored Disconnected message must not delay cleanup behind buffered data.
+    drop(peripheral);
+    Some(CoreBluetoothEvent::DeviceDisconnected { uuid })
