+        .call_method(
+            &exception,
+            jni::jni_str!("getMessage"),
+            jni::jni_sig!("()Ljava/lang/String;"),
+            &[],
+        )?
+        .l()?;
+    Ok(env
+        .cast_local::<jni::objects::JString>(message)?
+        .to_string())
