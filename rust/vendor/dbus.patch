+    /// Installs the unique name returned by an already completed asynchronous Hello.
+    /// This does not authenticate or register the connection. The name is copied
+    /// by libdbus and may only be installed once. Exclusive access prevents
+    /// invalidating a name borrowed through `unique_name`.
+    pub fn set_unique_name(&mut self, name: &str) -> Result<(), Error> {
+        if self.unique_name().is_some() {
+            return Err(Error::new_failed("D-Bus unique name is already installed"));
+        }
+        // libdbus accepts a bare ':' and other empty unique-name elements.
+        // Hello must return a colon-prefixed name with at least two elements.
+        if !name.starts_with(':') || !name[1..].contains('.')
+            || name[1..].split('.').any(|part| part.is_empty()) {
+            return Err(Error::new_failed("Expected a D-Bus unique name"));
+        }
+        let name = std::ffi::CString::new(name)
+            .map_err(|_| Error::new_failed("D-Bus unique name contains a NUL byte"))?;
+        let mut error = Error::empty();
+        // Validate even when the crate's no-string-validation feature is enabled.
+        if unsafe { ffi::dbus_validate_bus_name(name.as_ptr(), error.get_mut()) } == 0 {
+            return Err(error);
+        }
+        // Exclusive ownership and the check above satisfy libdbus's single-set
+        // precondition. The C API copies this temporary string before returning.
+        if unsafe { dbus_bus_set_unique_name(self.conn(), name.as_ptr()) } == 0 {
+            return Err(Error::new_failed("Failed to copy D-Bus unique name"));
+        }
+        Ok(())
+    }
