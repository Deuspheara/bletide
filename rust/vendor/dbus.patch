+#[cfg(all(test, unix))]
+mod openble_reply_ownership_tests {
+    use super::*;
+    use std::os::unix::net::UnixListener;
+
+    fn connection() -> (Arc<SyncConnection>, tempfile::TempDir, UnixListener, std::os::unix::net::UnixStream) {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("bus");
+        let listener = UnixListener::bind(&path).unwrap();
+        let channel = Channel::open_private(&format!("unix:path={}", path.display())).unwrap();
+        let (peer, _) = listener.accept().unwrap();
+        (Arc::new(SyncConnection::from(channel)), directory, listener, peer)
+    }
+
+    #[test]
+    fn dropping_unpolled_method_reply_retires_native_registration() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        assert_eq!(connection.replies_mut().len(), 1, "native registration was never established");
+        drop(pending);
+        assert_eq!(connection.replies_mut().len(), 0, "canceled native reply callback retained");
+    }
+
+    #[test]
+    fn dropping_polled_method_reply_retires_native_registration() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let mut pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        let mut context = task::Context::from_waker(task::Waker::noop());
+        assert!(pin::Pin::new(&mut pending).poll(&mut context).is_pending());
+        assert_eq!(connection.replies_mut().len(), 1);
+        drop(pending);
+        assert_eq!(connection.replies_mut().len(), 0, "canceled polled reply callback retained");
+    }
+    #[test]
+    fn method_reply_timeout_retires_registration_and_preserves_error() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let mut connection = Arc::try_unwrap(connection).ok().unwrap();
+        connection.set_timeout_maker(Some(|_| Box::pin(std::future::ready(()))));
+        let connection = Arc::new(connection);
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let mut pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        let mut context = task::Context::from_waker(task::Waker::noop());
+        match pin::Pin::new(&mut pending).poll(&mut context) {
+            task::Poll::Ready(Err(error)) => assert_eq!(error.name(), Some("org.freedesktop.DBus.Error.Timeout")),
+            result => panic!("expected native timeout, got {:?}", result),
+        }
+        assert_eq!(connection.replies_mut().len(), 0);
+    }
+
+    #[test]
+    fn successful_reply_and_late_canceled_reply_leave_no_registration() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        for canceled in [false, true] {
+            let mut pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+            let id = *connection.replies_mut().keys().next().unwrap();
+            let mut call = Message::new_method_call("org.example.Test", "/test", "org.example.Test", "Ping").unwrap();
+            call.set_serial(id.0 as u32);
+            let reply = call.method_return();
+            if canceled { drop(pending); connection.process_one(reply); }
+            else {
+                connection.process_one(reply);
+                let mut context = task::Context::from_waker(task::Waker::noop());
+                assert!(matches!(pin::Pin::new(&mut pending).poll(&mut context), task::Poll::Ready(Ok(()))));
+            }
+            assert_eq!(connection.replies_mut().len(), 0);
+        }
+    }
+
+    #[test]
+    fn stale_reply_guard_preserves_a_reused_native_token() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        let id = *connection.replies_mut().keys().next().unwrap();
+        drop(connection.cancel_reply(id));
+        connection.replies_mut().insert(id, (Arc::new(()), Box::new(|_, _| {})));
+        drop(pending);
+        assert_eq!(connection.replies_mut().len(), 1, "old guard removed a new callback");
+        drop(connection.cancel_reply(id));
+    }
+
+    #[test]
+    fn pending_reply_guard_does_not_retain_the_native_connection() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let weak = Arc::downgrade(&connection);
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        drop(proxy);
+        drop(connection);
+        assert!(weak.upgrade().is_none());
+        drop(pending);
+    }
+
+    #[test]
+    fn repeated_reply_cancellation_returns_registry_to_baseline() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        for _ in 0..100 {
+            let mut pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+            let mut context = task::Context::from_waker(task::Waker::noop());
+            assert!(pin::Pin::new(&mut pending).poll(&mut context).is_pending());
+            drop(pending);
+            assert_eq!(connection.replies_mut().len(), 0);
+        }
+    }
+
+    #[test]
