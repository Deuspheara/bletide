+        let proxy = Proxy::new("org.example.Test", "/test", Duration::from_secs(1), connection.clone());
+        let mut pending: MethodReply<()> = proxy.method_call("org.example.Test", "Ping", ());
+        let mut context = task::Context::from_waker(task::Waker::noop());
+        assert!(matches!(pin::Pin::new(&mut pending).poll(&mut context), task::Poll::Ready(Err(_))));
+        assert_eq!(connection.replies_mut().len(), 0);
+    }
+
+    #[test]
+    fn native_reply_callback_runs_outside_the_registry_lock() {
+        let (connection, _directory, _listener, _peer) = connection();
+        let call = Message::new_method_call("org.example.Test", "/test", "org.example.Test", "Ping").unwrap();
+        let mut reply_call = call.duplicate().unwrap();
+        let token = connection.send_with_reply(call, Box::new(|_, connection| {
+            assert!(connection.replies.try_lock().is_ok(), "reply callback holds registry lock");
+        })).unwrap();
+        reply_call.set_serial(token.0 as u32);
+        connection.process_one(reply_call.method_return());
+        assert_eq!(connection.replies_mut().len(), 0);
+    }
